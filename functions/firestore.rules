rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ユーザー情報
    // ============================================
    match /users/{userId} {
      // 本人のみ読み取り・更新可能
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // 自分自身のドキュメントのみ作成可能
      allow create: if request.auth != null && request.auth.uid == userId;
      // 削除は Cloud Functions のみ許可
      allow delete: if false;
    }
    
    // ============================================
    // 心拍データ
    // ============================================
    match /heartRates/{heartRateId} {
      // 本人のデータのみ読み取り可能
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // 本人のみ作成可能（userId が一致することを確認）
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // 更新・削除は禁止（不変データ）
      allow update, delete: if false;
    }
    
    // ============================================
    // 共有リクエスト
    // ============================================
    match /shareRequests/{requestId} {
      // 送信者または受信者のみ読み取り可能
      allow read: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      
      // 送信者のみ作成可能
      allow create: if request.auth != null && 
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid;
      
      // 受信者のみステータス更新可能
      allow update: if request.auth != null && 
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['status', 'respondedAt']);
      
      // 削除は禁止
      allow delete: if false;
    }
    
    // ============================================
    // 共有グループ
    // ============================================
    match /shareGroups/{groupId} {
      // メンバーのみ読み取り可能
      allow read: if request.auth != null && 
        resource.data.memberIds.hasAny([request.auth.uid]);
      
      // 認証ユーザーのみ作成可能
      allow create: if request.auth != null;
      
      // 所有者のみ更新・削除可能
      allow update, delete: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
    }
    
    // ============================================
    // セキュリティ設定
    // ============================================
    match /security/{userId} {
      // 本人のみ読み取り可能
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // 本人のみ作成可能
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // 更新は Cloud Functions のみ許可（クライアントから直接更新不可）
      allow update: if false;
      
      // 削除は禁止
      allow delete: if false;
    }
    
    // ============================================
    // セキュリティログ
    // ============================================
    match /security_logs/{logId} {
      // 本人のログのみ読み取り可能
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // 作成は Cloud Functions のみ許可
      allow create: if false;
      
      // 更新・削除は禁止（不変データ）
      allow update, delete: if false;
    }
    
    // ============================================
    // トランザクション署名
    // ============================================
    match /transaction_signatures/{signatureId} {
      // 本人の署名のみ読み取り可能
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // 作成は Cloud Functions のみ許可
      allow create: if false;
      
      // 更新・削除は禁止
      allow update, delete: if false;
    }
    
    // ============================================
    // レート制限（内部管理用）
    // ============================================
    match /rate_limits/{limitId} {
      // すべて禁止（Cloud Functions 内部でのみ使用）
      allow read, create, update, delete: if false;
    }
    
  }
}
